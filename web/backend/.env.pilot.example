# Copy to .env.pilot and replace CHANGE_ME locally. Never commit .env.pilot.
MARKETPLACE_ENVIRONMENT=development
MARKETPLACE_FRONTEND_URL=http://localhost:3000
MARKETPLACE_JWT_SECRET=CHANGE_ME_generate_a_random_32_plus_character_value
MARKETPLACE_MARKETPLACE_TOKEN_KEY=CHANGE_ME_fernet_key
MARKETPLACE_MFA_ENCRYPTION_KEY=CHANGE_ME_separate_fernet_key
MARKETPLACE_BILLING_PROVIDER=not_configured
MARKETPLACE_MARKETPLACE_LIMITER_BACKEND=redis
MARKETPLACE_RUN_FBO_MONITOR_IN_API=false
POSTGRES_DB=trovendi_pilot
POSTGRES_USER=trovendi_pilot
# Hex only, at least 32 characters; generate with: python -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=CHANGE_ME_local_only_hex_password
